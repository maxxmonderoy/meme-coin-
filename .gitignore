# --- key material -------------------------------------------------------
# Per CLAUDE.md 3.10.6 the real key file must NOT be named .env or
# PRIVATE_KEY or sit at the default keypair path. These patterns are the
# defensive floor, not the naming convention.
.env
.env.*
!.env.example
*.key
*.pem
*keypair*.json
id.json
secrets/
keys/
wallets/
# The filename README.md recommends for local config (see 3.10.6). It holds the
# provider endpoint and token, so it must never be committable.
trenches.local.conf
*.local.conf

# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- data / journal -----------------------------------------------------
# The Postgres journal is the product; dumps and captures stay local.
*.sqlite
*.sqlite3
*.db
# SQLite's WAL sidecars. `*.db` does not match these, and in WAL mode they are
# live files that change on every write -- committing one put a 15 MB blob in
# the history and leaked collected data that this section exists to keep local.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.dump
*.sql.gz
data/
captures/
logs/
*.log

# --- tooling ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
node_modules/
