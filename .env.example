# Copy to a file that is NOT named .env (3.10.6 -- stealers grep for `.env`
# and `PRIVATE_KEY` by name), then point TRENCHES_ENV_FILE at it:
#
#   cp .env.example trenches.local.conf && export TRENCHES_ENV_FILE=trenches.local.conf
#
# There are no keys here and there will not be until week 6. Nothing in this
# project can construct or sign a transaction. BUDGET FOR ALL OF THIS: $0.

# --- storage ------------------------------------------------------------
# SQLite by default (3.2). Postgres is a connection-string change and nothing
# else -- both are tested:  postgresql://user@host:5432/trenches
TRENCHES_DSN=sqlite://./trenches.db

# --- feeds --------------------------------------------------------------
# Comma-separated, raced concurrently and deduped on mint. Both are free.
#   pumpportal  primary launch feed, ONE connection ever
#   rugcheck    second feed, polled with a cache-buster
#   replay      capture files, needs no network
TRENCHES_FEEDS=pumpportal,rugcheck

# --- pumpportal ---------------------------------------------------------
# ONE connection at a time. A second concurrent connection earns an hourly
# ban, and a reconnect that opens before closing will do exactly that.
TRENCHES_PUMPPORTAL_URL=wss://pumpportal.fun/api/data
# true = abort on any frame that fails schema validation. Default false:
# record the mismatch, keep the raw frame, keep running.
TRENCHES_PUMPPORTAL_STRICT=false

# --- rugcheck new_tokens ------------------------------------------------
# Every request carries a cache-buster. WITHOUT one this endpoint serves
# ~3-hour-old entries and looks perfectly healthy while being useless, so the
# consumer refuses to start if the newest entry is older than the limit below.
TRENCHES_RUGCHECK_BASE=https://api.rugcheck.xyz/v1
TRENCHES_RUGCHECK_INTERVAL_SECONDS=2.0
TRENCHES_RUGCHECK_STARTUP_MAX_AGE_SECONDS=600

# --- replay -------------------------------------------------------------
TRENCHES_REPLAY_PATH=./captures

# --- ingest tuning ------------------------------------------------------
TRENCHES_QUEUE_MAXSIZE=10000
TRENCHES_WORKERS=4
TRENCHES_DEDUPE_TTL_SECONDS=900
TRENCHES_KEEPALIVE_SECONDS=30
TRENCHES_BACKOFF_MIN_SECONDS=1
TRENCHES_BACKOFF_MAX_SECONDS=30

# --- retention ----------------------------------------------------------
# creates_full = full payload for launches, per-minute counters for the rest
TRENCHES_RETENTION=creates_full
TRENCHES_RAW_RETENTION_DAYS=7

TRENCHES_ENRICH_CACHE_TTL_SECONDS=300
TRENCHES_LOG_LEVEL=INFO
