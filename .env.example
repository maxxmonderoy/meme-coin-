# Copy to a file that is NOT named .env (3.10.6 -- stealers grep for `.env`
# and `PRIVATE_KEY` by name), then point TRENCHES_ENV_FILE at it:
#
#   cp .env.example trenches.local.conf && export TRENCHES_ENV_FILE=trenches.local.conf
#
# There are no keys here and there will not be until week 6. Nothing in this
# project can construct or sign a transaction. BUDGET FOR ALL OF THIS: $0.

# --- storage ------------------------------------------------------------
# SQLite by default (3.2). Postgres is a connection-string change and nothing
# else -- both are tested:  postgresql://user@host:5432/trenches
TRENCHES_DSN=sqlite://./trenches.db

# --- feeds --------------------------------------------------------------
# Comma-separated, raced concurrently and deduped on mint. Both are free.
#   pumpportal  primary launch feed, ONE connection ever
#   rugcheck    second feed, polled with a cache-buster
#   replay      capture files, needs no network
TRENCHES_FEEDS=pumpportal,rugcheck

# --- pumpportal ---------------------------------------------------------
# ONE connection at a time. A second concurrent connection earns an hourly
# ban, and a reconnect that opens before closing will do exactly that.
TRENCHES_PUMPPORTAL_URL=wss://pumpportal.fun/api/data
# true = abort on any frame that fails schema validation. Default false:
# record the mismatch, keep the raw frame, keep running.
TRENCHES_PUMPPORTAL_STRICT=false

# --- rugcheck new_tokens ------------------------------------------------
# Every request carries a cache-buster. WITHOUT one this endpoint serves
# ~3-hour-old entries and looks perfectly healthy while being useless, so the
# consumer refuses to start if the newest entry is older than the limit below.
TRENCHES_RUGCHECK_BASE=https://api.rugcheck.xyz/v1
TRENCHES_RUGCHECK_INTERVAL_SECONDS=2.0
TRENCHES_RUGCHECK_STARTUP_MAX_AGE_SECONDS=600

# --- replay -------------------------------------------------------------
TRENCHES_REPLAY_PATH=./captures

# --- ingest tuning ------------------------------------------------------
TRENCHES_QUEUE_MAXSIZE=10000
TRENCHES_WORKERS=4
TRENCHES_DEDUPE_TTL_SECONDS=900
TRENCHES_KEEPALIVE_SECONDS=30
TRENCHES_BACKOFF_MIN_SECONDS=1
TRENCHES_BACKOFF_MAX_SECONDS=30

# --- retention ----------------------------------------------------------
# creates_full = full payload for launches, per-minute counters for the rest
TRENCHES_RETENTION=creates_full
TRENCHES_RAW_RETENTION_DAYS=7

TRENCHES_ENRICH_CACHE_TTL_SECONDS=300
TRENCHES_LOG_LEVEL=INFO

# --- decide: cascade thresholds -----------------------------------------
# Snapshotted into every decision row, so changing one here does NOT silently
# invalidate the comparability of rows written before the change.
TRENCHES_DECIDE_CREATOR_MIN_MINTS=3
TRENCHES_DECIDE_CREATOR_MAX_RUG_RATE=0.6

# UNCALIBRATED. 3.4 gives no liquidity floor, and 1.2's $1,000 figure measures a
# token being effectively DEAD, not a floor for entry. Every row carries
# calibrated=false alongside this number until it is tuned against matched
# controls -- an assumption the journal records, not a finding.
TRENCHES_DECIDE_MIN_LIQUIDITY_USD=5000

# Reject an LP lock that expires inside the holding horizon (3.4). A lock that
# ends while you hold is a countdown, and the deployer chose when it ends.
TRENCHES_DECIDE_HOLD_HORIZON_SECONDS=21600

# --- decide: stage 4, concentration and coordination --------------------
# These five ARE 3.4's stated numbers. Note the comparators differ: bundler
# COUNT is >=, everything else is strictly >.
TRENCHES_DECIDE_MAX_DEV_PCT=5
TRENCHES_DECIDE_MAX_SNIPERS=20
TRENCHES_DECIDE_MAX_INSIDERS=20
TRENCHES_DECIDE_MAX_BUNDLER_PCT=15
TRENCHES_DECIDE_MAX_BUNDLER_COUNT=100

# Below this age a behavioural ZERO is a cold start, not a clean result. Every
# stage-4 rule is "reject if > N", so an unguarded stage 4 does not merely fail
# to reject a young mint -- it actively passes it on a payload of zeros. 600s is
# the conservative end of Part 2's 2-10 minute populate window.
TRENCHES_DECIDE_COLD_START_SECONDS=600

# --- decide: stage 5, funding-chain clustering --------------------------
# 15% IS 3.4's number: reject if the largest non-CEX cluster exceeds this share
# of supply.
TRENCHES_DECIDE_MAX_CLUSTER_PCT=15

# Path to a JSON label set: {"cex": [...], "dex": [...], "pool": [...],
# "locker": [...]}. See labels.example.json, which ships EMPTY on purpose.
# UNSET MEANS STAGE 5 CANNOT REJECT. Without CEX addresses stripped, every
# wallet funded from one exchange hot wallet unions into a single cluster
# spanning most of the holder set, and stage 5 would reject nearly every token
# while looking like it found coordination. It computes and journals instead.
# No addresses are shipped because an exchange hot wallet recalled from memory
# is an invented constant, and exchanges rotate them.
TRENCHES_LABEL_SET_PATH=
