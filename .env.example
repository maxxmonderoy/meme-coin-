# Copy to a file that is NOT named .env, per CLAUDE.md 3.10.6 -- credential
# stealers grep for `.env` and `PRIVATE_KEY` by name. Point TRENCHES_ENV_FILE
# at whatever you name it, or export these directly.
#
#   cp .env.example trenches.local.conf && export TRENCHES_ENV_FILE=trenches.local.conf
#
# There are no signing keys here and there will not be until week 6. Week 1
# reads a stream and writes a journal. Nothing in this project can spend.

# --- database -----------------------------------------------------------
TRENCHES_DSN=postgresql://trenches:trenches@127.0.0.1:5432/trenches

# --- feed selection -----------------------------------------------------
# yellowstone | pumpportal | replay
# `replay` reads recorded frames from disk and needs no credentials. It is
# the only feed that works without a subscription.
TRENCHES_FEED=replay
TRENCHES_REPLAY_PATH=./captures

# --- yellowstone gRPC (Chainstack) --------------------------------------
# Endpoint host:port, no scheme. Leave blank until you have a subscription.
TRENCHES_YELLOWSTONE_ENDPOINT=
TRENCHES_YELLOWSTONE_TOKEN=
TRENCHES_YELLOWSTONE_TLS=true

# --- pumpportal ---------------------------------------------------------
# ONE connection only. Multiple concurrent connections get hourly-banned
# (CLAUDE.md 3.2). The supervisor enforces a single in-process connection;
# it cannot stop you running two copies of the program.
TRENCHES_PUMPPORTAL_URL=wss://pumpportal.fun/api/data

# --- filter -------------------------------------------------------------
# strict  = account_include[pump] AND account_required[metaplex]  (3.3)
# naive   = account_include[pump] only, ~99% discarded client-side
# both    = run both subscriptions and diff detected mints. Do this for an
#           hour before trusting `strict` -- pump.fun's create account list
#           has changed at least once.
TRENCHES_FILTER_MODE=both

# --- ingest tuning ------------------------------------------------------
TRENCHES_QUEUE_MAXSIZE=10000
TRENCHES_WORKERS=4
TRENCHES_DEDUPE_TTL_SECONDS=90
TRENCHES_SLOT_WATCHDOG_SECONDS=3.0
TRENCHES_KEEPALIVE_SECONDS=30
TRENCHES_BACKOFF_MIN_SECONDS=1
TRENCHES_BACKOFF_MAX_SECONDS=30

# --- retention ----------------------------------------------------------
# creates_full  = full payload for creates, per-minute counters for the rest
# all           = full payload for everything (tens of GB/week)
# creates_only  = creates, no counters (weakest canary)
TRENCHES_RETENTION=creates_full
TRENCHES_RAW_RETENTION_DAYS=7

# --- enrichment (manual command only in week 1) -------------------------
TRENCHES_RUGCHECK_BASE=https://api.rugcheck.xyz/v1
TRENCHES_ENRICH_CACHE_TTL_SECONDS=300
